# Ojo de Dios — example local configuration.
# Copy this file to .env for a private workstation. Never commit real .env files.

PRODUCT_INTERNAL_NAME=ojo_de_dios
PRODUCT_DISPLAY_NAME=Ojo de Dios
APP_VERSION=0.1.0
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DEFAULT_EXECUTION_MODE=demo

# Storage / retention
DATABASE_URL=sqlite:///./storage/runtime/ojo_de_dios.sqlite3
AUTO_CLEANUP_ENABLED=0
EVIDENCE_RETENTION_DAYS=90
JOB_LOG_RETENTION_DAYS=30
HERMES_EVIDENCE_RETENTION_DAYS=180
KEEP_FAILED_RUNS=1
KEEP_DEMO_RUNS=1

# Initial local admin bootstrap. Leave password empty until first-run flow sets it.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
PASSWORD_HASH_ITERATIONS=260000

# Global AI switch. If AI_ENABLED=0, Ojo de Dios must not use LaIA/Mistral or Hermes Agent.
AI_ENABLED=0
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_SECONDS=30

# LaIA / Mistral local station. MISTRAL_ENABLED is evaluated only when AI_ENABLED=1.
MISTRAL_ENABLED=0
MISTRAL_API_URL=http://localhost:11434
MISTRAL_CHAT_API_URL=http://localhost:11434/api/chat
MISTRAL_MODEL=CognitiveComputations/dolphin-mistral-nemo:12b
MISTRAL_MODEL_DISPLAY_NAME=Dolphin Mistral Nemo 12B
MISTRAL_PROMPT_TEMPLATE=chatml
MISTRAL_CONTEXT_WINDOW_TOKENS=128000
MISTRAL_GUARDRAILS_REQUIRED=1
MISTRAL_TIMEOUT_SECONDS=120
MISTRAL_SYSTEM_PROMPT_PATH=docs/ai_prompts/laia_mistral_system_prompt.md
OLLAMA_MODELS=storage/models/ollama
OLLAMA_MODELS_DIR=storage/models/ollama
LAIA_MODE=local
LAIA_JSON_ONLY=1

# Hermes Agent Lab. ANGEL_ENABLED is evaluated only when AI_ENABLED=1.
ANGEL_ENABLED=0
ANGEL_INTERNAL_NAME=hermes_lab
ANGEL_DISPLAY_NAME=Hermes Agent Lab
ANGEL_LEGACY_ALIAS=
ANGEL_PROVIDER=deepseek
ANGEL_WORKSPACE=modules/laboratory
ANGEL_PROMPT_PATH=docs/ai_prompts/angel_hermes_system_prompt.md
ANGEL_ALLOW_DEPENDENCY_INSTALL=0
ANGEL_REQUIRE_APPROVAL=1
ANGEL_SANDBOX_ONLY=1
ANGEL_OUTPUT_MANIFEST=1
ANGEL_PROPOSAL_MANIFEST=PROMOTION_MANIFEST.json
ANGEL_PROMOTED_MANIFEST_DIR=modules/laboratory/_promoted_manifest

# DeepSeekAssist external brain. Use DeepSeek Pro as the main Hermes Agent model; Flash is reserved for healthchecks, quick summaries, simple classification and fallback.
# Replace only in your private .env; never commit a real key or logs containing it.
DEEPSEEK_API_KEY=ALAZAN_REEMPLAZAR_EN_ENV_LOCAL
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_ALLOW_PRO_WITHOUT_EXPLICIT_APPROVAL=0
